# Copy to .env and fill in. Anything left blank keeps that feature switched off.
SHOP_PASSWORD=change-this

# Direct UPI: money lands in this account instantly, and the shop confirms it by
# hand against their bank app. Leave blank to hide paying by UPI.
UPI_ID=
UPI_NAME=Printout

# Razorpay: card, netbanking, and UPI through the gateway. Payments verify
# themselves, so the shop has nothing to check. Both lines are needed before the
# button appears. Test keys start rzp_test_ and move no real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Per page, in rupees
RATE_BW=2
RATE_COLOR=10
